---
import PromptPanel from './PromptPanel.astro';
import SectionHeading from './SectionHeading.astro';
import { heroBackgroundScript } from '../lib/hero-background';
import { getPrompts } from '../lib/prompts';
import { createTranslator, type Language } from '../lib/i18n';

interface Props { language: Language; }
const { language } = Astro.props;
const t = createTranslator(language);
const { prompts, bundle, bundleFilename } = getPrompts(language);
const messages = {
  manualCopy: t('Το κείμενο επιλέχθηκε. Πάτησε Ctrl+C ή ⌘C για χειροκίνητη αντιγραφή.'),
  copiedPrefix: t('Αντιγράφηκε:'),
  paste: t('Επικόλλησέ το στο ChatGPT.'),
  expand: t('Ανάπτυξη κειμένου'),
  collapse: t('Σύμπτυξη κειμένου'),
  bundleFilename,
};

const repository = 'michailkoutsouris/themis-ai';
const repositoryURL = `https://github.com/${repository}`;

// Escape HTML delimiters so Markdown cannot terminate a JSON script element.
const serialize = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={language}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href={language === 'en' ? '../favicon.svg' : 'favicon.svg'} />
  <link rel="icon" type="image/png" sizes="32x32" href={language === 'en' ? '../favicon-32.png' : 'favicon-32.png'} />
  <link rel="apple-touch-icon" href={language === 'en' ? '../apple-touch-icon.png' : 'apple-touch-icon.png'} />
  <meta name="theme-color" content="#173f35">
  <meta name="description" content={t("Θέμις: έτοιμα ελληνικά prompts για μεθοδική νομική έρευνα και σύνταξη αγωγών και ασφαλιστικών μέτρων στο ChatGPT. Οδηγίες, ρυθμίσεις και πηγές.")}>
  <title>{t("Θέμις — Από την υπόθεση, στο κείμενο.")}</title>
  <link rel="alternate" hreflang="el" href="/" />
  <link rel="alternate" hreflang="en" href="/en/" />
  <style is:global>
    :root{--paper:#f6f4ed;--white:#fffef9;--ink:#24342d;--green:#173f35;--green-light:#e5ebe1;--line:#dcded3;--muted:#637064;--orange:#ba5938;--serif:Georgia,'Times New Roman',serif;--sans:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:30px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.65}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer}a{color:inherit;text-underline-offset:4px}button:focus-visible,a:focus-visible,textarea:focus-visible{outline:3px solid var(--orange);outline-offset:5px}button:disabled{cursor:wait;opacity:.7}button{touch-action:manipulation}::selection{background:#d7e5ca;color:var(--green)}[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip{position:fixed;top:10px;left:10px;transform:translateY(-180%);background:var(--green);color:white;padding:12px;z-index:20}.skip:focus{transform:none}.dot{width:6px;height:6px;border-radius:50%;background:var(--orange)}.eyebrow{display:block;color:var(--muted);font-size:10px;letter-spacing:1.5px;font-weight:600;text-transform:uppercase}.hero h1{font-family:var(--serif);font-weight:400;font-size:clamp(38px,4.1vw,65px);line-height:1.12;letter-spacing:-2.5px;margin:20px 0 23px}.hero h1 em{font-style:normal;color:var(--orange)}.hero-copy{max-width:580px;color:var(--muted);font-size:15px;line-height:1.85;margin:0}.hero-actions{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-top:29px}.button{display:inline-flex;justify-content:center;align-items:center;gap:18px;padding:13px 20px;min-height:48px;border:1px solid transparent;text-decoration:none;font-size:13px;font-weight:550;border-radius:3px;transition:background .15s,transform .15s}.button.primary{background:var(--green);color:var(--white)}.button.primary:hover{background:#255446}.button.secondary{background:transparent;border-color:#c8cebf;color:var(--green)}.button.secondary:hover{background:var(--green-light)}.text-link{font-size:12px;font-weight:500}.scope-strip{border-block:1px solid var(--line);padding:15px 0;display:flex;gap:25px;align-items:center;color:var(--muted);font-size:11px}.scope-strip span{display:flex;align-items:center;gap:9px}.scope-strip b{font-size:12px;color:var(--orange);font-weight:400}.section{padding:49px 0;border-bottom:1px solid var(--line)}.section-header p{font-size:13px;color:var(--muted);margin:0;max-width:660px}.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.step{padding:22px 0 0;border-top:1px solid #b5c1ae}.step-num{font:11px ui-monospace,monospace;color:var(--muted);display:block;margin-bottom:13px}.step h3{font-size:14px;margin:0 0 8px;font-weight:600}.step p{font-size:12px;color:var(--muted);margin:0;line-height:1.85}.small-note{margin-top:23px;padding:15px 19px;background:#eeece2;border-left:2px solid #a99e7d;color:#66644f;font-size:12px;line-height:1.85}.small-note strong{color:var(--ink)}.setup{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);background:var(--white);border-radius:4px}.model-card{padding:27px;border-right:1px solid var(--line);display:flex;flex-direction:column}.recommended{font:10px ui-monospace,monospace;letter-spacing:1px;color:var(--orange);display:flex;align-items:center;gap:7px}.model-card h3{font:36px var(--serif);letter-spacing:-1px;margin:13px 0 4px}.model-card p{font-size:12px;color:var(--muted);margin:0 0 15px}.model-card .model-foot{font-size:11px;line-height:1.8;margin:auto 0 0}.settings-list{padding:12px 24px;margin:0;list-style:none}.settings-list li{padding:13px 0;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);gap:15px;font-size:12px}.settings-list li:last-child{border:0}.setting-value{color:var(--green);font-weight:600;text-align:right}.sources-inline{font-size:11px;color:var(--muted);margin:15px 0 0;line-height:1.9}.sources-inline a:hover{color:var(--orange)}
    .library{background:var(--white);border:1px solid var(--line);border-radius:4px;overflow:hidden}.tab[aria-selected=true]{border-bottom-color:var(--green);color:var(--green);font-weight:650}.tab:hover{background:#e4e8db}.prompt-panel{padding:26px 27px 0}.prompt-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;margin-bottom:21px}.prompt-heading h3{font-family:var(--serif);font-size:25px;letter-spacing:-.4px;font-weight:400;margin:8px 0 5px}.prompt-heading p{margin:0;color:var(--muted);font-size:12px;max-width:610px}.file-type{font:11px ui-monospace,monospace;padding:4px 8px;background:var(--green-light);color:var(--green);border:1px solid #d6dfd1;border-radius:3px}.prompt-text{width:100%;display:block;min-height:340px;height:360px;padding:21px;border:1px solid #e0e3d7;border-radius:2px;background:#f7f8f1;color:#384638;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;line-height:1.95;resize:vertical;tab-size:2;white-space:pre-wrap;overflow-wrap:anywhere}.prompt-text.expanded{height:680px}.prompt-bottom{display:flex;justify-content:space-between;align-items:center;gap:15px;min-height:53px;color:var(--muted);font-size:10px}.text-button{border:0;padding:10px 0;background:transparent;color:var(--green);font-size:11px}.text-button span{margin-left:8px}.library-actions{padding:18px 27px;display:flex;justify-content:space-between;align-items:center;gap:15px;border-top:1px solid var(--line);background:#fafbf4}.library-actions .button{font-size:12px}.download{font-size:11px;display:flex;align-items:center;gap:8px}.library-help{font-size:12px;color:var(--muted);margin:17px 0 0;line-height:1.85}.team{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0}.person{padding:20px 12px 20px 0;border-top:1px solid var(--line)}.person:nth-child(n+5){border-top:1px solid var(--line)}.person-name{font:21px var(--serif);margin:0 0 5px}.person-task{font-size:11px;color:var(--muted);line-height:1.7;margin:0}.specialists{font-size:12px;color:var(--muted);padding-top:18px;border-top:1px solid var(--line);margin:0}.source-list{display:grid;grid-template-columns:1fr 1fr;gap:0 30px}.source-row{display:flex;justify-content:space-between;gap:15px;text-decoration:none;border-top:1px solid var(--line);padding:17px 0}.source-row strong{font-size:12px;font-weight:550;display:block}.source-row small{color:var(--muted);font-size:11px;display:block;margin-top:3px}.source-row .arrow{font-size:18px;color:var(--orange)}.source-row:hover strong{text-decoration:underline;text-underline-offset:4px}.faq{margin-top:25px}.faq details{border-top:1px solid var(--line);padding:16px 0}.faq summary{cursor:pointer;font-size:13px;font-weight:550}.faq details p{font-size:12px;line-height:1.85;color:var(--muted);margin:11px 0 0;max-width:800px}.closing{display:grid;gap:12px;padding:26px 0 35px;color:var(--muted);font-size:10px}.closing p{margin:0}.closing-meta{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:baseline;gap:24px}.closing-version{white-space:nowrap;font-family:ui-monospace,monospace}.toast{position:fixed;bottom:26px;left:50%;transform:translate(-50%,20px);background:var(--green);color:white;padding:13px 21px;border-radius:4px;font-size:12px;box-shadow:0 6px 28px #173f3522;max-width:calc(100% - 30px);z-index:100;opacity:0;pointer-events:none;transition:opacity .15s,transform .15s}.toast.show{opacity:1;transform:translate(-50%,0)}.noscript{padding:16px;background:#ece6d6;font-size:13px}
    .repo-meta{display:flex;align-items:center;gap:16px;flex-shrink:0}.repo-meta a{text-decoration:none;display:inline-flex;align-items:center;gap:6px;min-height:28px}.repo-meta a:hover{text-decoration:underline}.repo-link{color:var(--green);font-weight:600}.github-icon{display:block;flex-shrink:0}.closing .license-note{line-height:1.9}.license-note a{color:var(--green)}
    @media(max-width:1100px){.hero h1{font-size:46px;letter-spacing:-1.8px}.scope-strip{gap:17px}.scope-strip span{font-size:10px}.team{grid-template-columns:repeat(2,minmax(0,1fr))}.model-card,.prompt-panel{padding:22px}.library-actions{padding:17px 22px}}
    @media(max-width:800px){.hero h1{font-size:43px}.hero-copy{font-size:13px}.section{padding:35px 0}.section-header p{font-size:12px}.steps{gap:19px}.setup{grid-template-columns:1fr 1fr}.model-card{padding:23px 20px}.settings-list{padding:10px 18px}.settings-list li{font-size:11px}.prompt-panel{padding:22px 20px 0}.library-actions{padding:16px 20px}}
    @media(max-width:560px){.hero h1{font-size:45px;letter-spacing:-1.6px}.hero-copy{font-size:14px}.hero-actions{gap:20px;margin-top:24px}.hero-actions .button{width:100%;justify-content:space-between}.hero-actions .text-link{font-size:12px}.scope-strip{flex-wrap:wrap;gap:7px 20px;padding:13px 0}.scope-strip span{font-size:10px}.steps{grid-template-columns:1fr;gap:19px}.step{padding-top:14px;display:grid;grid-template-columns:29px 1fr;gap:0 12px}.step-num{grid-row:1/3;margin-top:2px}.step h3{font-size:14px;margin-bottom:5px}.step p{font-size:12px}.setup{grid-template-columns:1fr}.model-card{border-right:0;border-bottom:1px solid var(--line)}.model-card h3{font-size:33px}.settings-list{padding:7px 20px}.settings-list li{font-size:12px}.prompt-heading h3{font-size:23px}.prompt-heading p{font-size:11px}.prompt-panel{padding:20px 14px 0}.prompt-text{font-size:11px;padding:14px;height:365px}.prompt-text.expanded{height:600px}.library-actions{padding:15px 14px;align-items:stretch;flex-direction:column}.library-actions .button{justify-content:space-between}.download{justify-content:center;padding:6px 0}.prompt-bottom{gap:8px;font-size:9px}.text-button{font-size:10px}.team{gap:0 14px}.person{padding-right:0}.person-name{font-size:20px}.source-list{grid-template-columns:1fr}.closing{gap:10px}.closing-meta{gap:16px}.small-note{padding:13px 15px}.eyebrow{font-size:9px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
    @media print{.hero-actions,.library-actions,.tabs,.toast,.expand{display:none!important}.section{break-inside:avoid}.prompt-text{height:250px}body{background:white}}

    /* Standards-based scrollbars, with precise 6px styling in WebKit/Blink. */
    *{scrollbar-width:thin;scrollbar-color:#879580 transparent}
    @supports selector(::-webkit-scrollbar){
      *{scrollbar-width:auto;scrollbar-color:auto}
      *::-webkit-scrollbar{width:6px;height:6px}
      *::-webkit-scrollbar-track{background:transparent}
      *::-webkit-scrollbar-thumb{background:#879580;border-radius:99px}
      *::-webkit-scrollbar-thumb:hover{background:var(--muted)}
      *::-webkit-scrollbar-corner{background:transparent}
      *::-webkit-scrollbar-button{display:none}
    }
    @media(forced-colors:active){*{scrollbar-color:auto}*::-webkit-scrollbar-thumb{background:CanvasText}}
    .top-actions{display:flex;flex-wrap:wrap;align-items:center;gap:18px}.language-switch{display:flex;align-items:center;gap:3px}.language-switch a{display:inline-flex;align-items:center;justify-content:center;min-height:32px;min-width:34px;padding:4px 7px;border:1px solid transparent;border-radius:3px;text-decoration:none;font-size:11px}.language-switch a[aria-current=page]{background:var(--green-light);border-color:#c8cebf;color:var(--green);font-weight:650}.language-switch a:hover{color:var(--orange)}
    .hero-content{position:relative;z-index:1;width:100%}.hero-waves{position:absolute;inset:0;z-index:-2;pointer-events:none;background:radial-gradient(ellipse at 80% 50%,#e5ebe177,transparent 70%)}.hero-waves canvas{display:block;width:100%;height:100%}.landing::after{content:'';position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(90deg,var(--paper) 0%,#f6f4edeb 30%,#f6f4ed80 65%,#f6f4ed00 100%)}
    .section-header{display:flex;flex-direction:column;align-items:flex-start;gap:13px;margin-bottom:28px}.section-title-row{display:flex;align-items:flex-start;gap:10px;font-size:32px;line-height:1.2}.section-title-row h2{font-family:var(--serif);font-size:inherit;font-weight:400;line-height:inherit;letter-spacing:-.6px;margin:0}.section-title-row .section-icon{display:block;flex:none;width:1.2em;height:1.2em;color:var(--orange)}
    .tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));width:100%;padding:0;background:#eeefe6;border-bottom:1px solid var(--line)}.tab{display:flex;align-items:center;justify-content:center;min-width:0;min-height:68px;padding:18px 10px;white-space:normal;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted);font-size:16px;line-height:1.35;overflow-wrap:normal}
    @media(max-width:800px){.section-title-row{font-size:29px}.tab{font-size:14px;padding-inline:8px}}
    @media(max-width:560px){.landing::after{background:linear-gradient(90deg,#f6f4edf5,#f6f4ed99)}.section-title-row{font-size:27px;gap:8px}.section-header{gap:11px}.tab{font-size:12px;min-height:64px;padding:15px 5px}}
    @media print{.hero-waves,.landing::after{display:none}}

    .layout{width:100%;margin:0}.main{--page-gutter:max(clamp(20px,5vw,80px),calc((100vw - 1440px)/2));min-width:0;padding:0 var(--page-gutter)}
    /* The auto navbar row is deducted from the first screen by CSS grid. */
    .landing{position:relative;isolation:isolate;overflow:hidden;margin-inline:calc(-1 * var(--page-gutter));min-height:100vh;min-height:100svh;min-height:100dvh;display:grid;grid-template-rows:auto 1fr}
    .topline{position:relative;z-index:1;background:transparent;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;min-height:104px;padding:22px var(--page-gutter);border:0;color:var(--muted);font-size:11px}
    .brand-lockup{display:flex;align-items:center;gap:22px;min-width:0;max-width:100%}.brand{display:inline-flex;align-items:center;flex-shrink:0;text-decoration:none}.brand-name{font-family:var(--serif);font-size:36px;line-height:1.2;letter-spacing:-1px;color:var(--ink)}.brand-sub{min-width:0;margin:0;border-inline-start:1px solid #b5c1ae;padding-inline-start:22px;font-size:13px;line-height:1.7;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted)}
    /* Center the slogan and divider on the logotype’s lowercase letter area (ι). */
    .brand-sub{padding-block:5px;transform:translateY(.25em)}
    @supports(text-box:trim-both ex alphabetic){.brand-name{text-box:trim-both ex alphabetic}.brand-sub{text-box:trim-both cap alphabetic;transform:none}}
    .hero{position:relative;z-index:1;display:grid;grid-template-rows:1fr auto;gap:48px;min-width:0;min-height:520px;padding:48px var(--page-gutter) 24px}.hero-content{align-self:center}.hero .scope-strip{align-self:end;border-bottom:0;padding:20px 0 0}
    @media(max-width:800px){.brand-name{font-size:30px}.brand-lockup{gap:16px}.brand-sub{padding-inline-start:16px;letter-spacing:1px}.topline{padding-block:19px}.hero{gap:40px;padding-block:40px 24px}}
    @media(max-width:560px){.topline{gap:15px;padding-block:18px}.brand-lockup{width:100%;gap:16px}.brand-sub{font-size:11px;letter-spacing:.9px;padding-inline-start:16px}.top-actions{margin-inline-start:auto}.hero{gap:36px;padding-block:36px 20px}}
    @media(max-width:380px){.brand-name{font-size:28px}.brand-lockup{gap:14px}.brand-sub{padding-inline-start:14px}}
    @media print{.main{padding:0}.landing{display:block;min-height:0;margin:0}.topline{display:none}.hero{min-height:0;padding:20px 0}}
  </style>
</head>
<body>
<a href="#content" class="skip">{t("Μετάβαση στο περιεχόμενο")}</a>
<div class="layout">
  <main class="main" id="content">
    <div class="landing" id="top">
      <div class="hero-waves" data-pattern-waves aria-hidden="true"></div>
    <header class="topline">
      <div class="brand-lockup">
        <a class="brand" href="#top" aria-label={t("Θέμις — αρχή")}><span class="brand-name">{t("Θέμις")}</span></a>
        <p class="brand-sub">{t("Νομική σκέψη, σε σειρά")}</p>
      </div>
      <div class="top-actions">
      <nav class="language-switch" aria-label={t("Γλώσσα")}>
        <a href={language === "el" ? "index.html" : "../index.html"} lang="el" hreflang="el" aria-label="Ελληνικά" title="Ελληνικά" aria-current={language === "el" ? "page" : undefined} data-language-link>ΕΛ</a>
        <a href={language === "el" ? "en/index.html" : "index.html"} lang="en" hreflang="en" aria-label="English" title="English" aria-current={language === "en" ? "page" : undefined} data-language-link>EN</a>
      </nav>
      <div class="repo-meta" aria-label={t("Αποθετήριο GitHub")}>
        <a class="repo-link" href={repositoryURL} target="_blank" rel="noopener noreferrer"><!-- GitHub mark: Primer Octicons (MIT); see /third-party-notices.txt. --><svg class="github-icon" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" /></svg><span>GitHub ↗</span></a>
      </div>
      </div>
    </header>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content"><span class="eyebrow">{t("ΑΓΩΓΕΣ & ΑΣΦΑΛΙΣΤΙΚΑ ΜΕΤΡΑ")}</span><h1 id="hero-title">{t("Η υπόθεσή σου.")}<br><em>{t("Μεθοδικά, από την αρχή.")}</em></h1><p class="hero-copy">{t("Μια ομάδα ειδικών ρόλων για την έρευνα, τις σωστές ερωτήσεις και τη σύνταξη. Αντέγραψε το prompt και ξεκίνα με τη Θέμις στο ChatGPT.")}</p><div class="hero-actions"><button class="button primary" data-copy="start">{t("Αντιγραφή βασικού prompt")} <span aria-hidden="true">↗</span></button><a class="text-link" href="https://chatgpt.com/" target="_blank" rel="noopener noreferrer">{t("Άνοιγμα ChatGPT ↗")}</a></div></div>
    <div class="scope-strip"><span><b aria-hidden="true">↳</b>{t("Ελλάδα · πολλαπλά αντικείμενα")}</span><span><b aria-hidden="true">↳</b>{t("Ερωτήσεις πριν από τη σύνταξη")}</span><span><b aria-hidden="true">↳</b>{t("Πλήρες κείμενο χωρίς placeholders")}</span></div>
    </section>
    </div>
    <section class="section" id="start" aria-labelledby="start-title">
      <SectionHeading icon="start" headingId="start-title" title={t("Από εδώ ξεκινάς.")} description={t("Δεν χρειάζεται να γνωρίζεις νομικούς όρους. Περιέγραψε τι συνέβη και τι θέλεις να πετύχεις.")} />
      <div class="steps"><article class="step"><span class="step-num">{t("ΒΗΜΑ 01")}</span><h3>{t("Άνοιξε νέα συνομιλία")}</h3><p>{t("Προτίμησε το Work, αν είναι διαθέσιμο. Επίλεξε μοντέλο και δυνατότητα αναζήτησης όπως περιγράφονται παρακάτω.")}</p></article><article class="step"><span class="step-num">{t("ΒΗΜΑ 02")}</span><h3>{t("Επικόλλησε το βασικό prompt")}</h3><p>{t("Πάτησε «Αντιγραφή βασικού prompt», επικόλλησέ το ως πρώτο μήνυμα και στείλε το. Δεν χρειάζεται να συμπληρώσεις πεδία.")}</p></article><article class="step"><span class="step-num">{t("ΒΗΜΑ 03")}</span><h3>{t("Απάντησε στις ερωτήσεις")}</h3><p>{t("Η Θέμις θα ζητήσει τα απαραίτητα στοιχεία και έγγραφα. Αν υπάρχει επίδοση, δικάσιμος ή κοντινή προθεσμία, ανέφερέ την αμέσως.")}</p></article></div>
      <div class="small-note"><strong>{t("Τι σημαίνει «χωρίς κενά»:")}</strong> {t("το prompt ζητά να καλυφθούν πρώτα τα αναγκαία στοιχεία. Αν ένα κρίσιμο στοιχείο ή μια νομική πηγή δεν μπορεί να επαληθευτεί, η πλήρης έκδοση σταματά με συγκεκριμένη εξήγηση. Δεν επινοούνται δεδομένα.")}</div>
    </section>
    <section class="section" id="settings" aria-labelledby="settings-title">
      <SectionHeading icon="settings" headingId="settings-title" title={t("Το περιβάλλον εργασίας σου.")} description={t("Προτεινόμενη αφετηρία για απαιτητική έρευνα. Τα ονόματα και οι επιλογές διαφέρουν ανά συνδρομή, λογαριασμό και workspace.")} />
      <div class="setup"><article class="model-card"><span class="recommended"><span class="dot" aria-hidden="true"></span>{t("ΠΡΟΤΕΙΝΟΜΕΝΟ · CHATGPT WORK")}</span><h3>GPT‑6 Astra</h3><p>{t("Για σύνθετη έρευνα και έλεγχο πολλών πηγών.")}</p><p class="model-foot">{t("Αν δεν εμφανίζεται, επίλεξε το ισχυρότερο διαθέσιμο reasoning μοντέλο με αναζήτηση και ανάγνωση αρχείων. Το GPT‑6.1 Sol είναι εναλλακτική όπου προσφέρεται. Μην θεωρείς ίδια την απόδοση χωρίς δοκιμή.")}</p></article><ul class="settings-list"><li><span>{t("Βάθος σκέψης")}</span><span class="setting-value">{t("High, όπου διατίθεται")}</span></li><li><span>{t("Ζωντανή αναζήτηση")}</span><span class="setting-value">{t("Διαθέσιμη & σε χρήση")}</span></li><li><span>{t("Ανάγνωση συνημμένων")}</span><span class="setting-value">{t("PDF / κείμενο / εικόνες")}</span></li><li><span>Deep research</span><span class="setting-value">{t("Προαιρετικά, για έρευνα")}</span></li><li><span>{t("Οργάνωση")}</span><span class="setting-value">{t("Μία υπόθεση ανά chat")}</span></li></ul></div>
      <p class="sources-inline">{t("Η επιλογή High είναι δική μας πρόταση για αυτό το σύνθετο έργο, όχι επίσημη νομική σύσταση ή εγγύηση. Δεν χρειάζεται ρύθμιση temperature ή API key για copy–paste στο ChatGPT. Το prompt δεν ενεργοποιεί εργαλεία ή μοντέλα από μόνο του.")} <a href="https://learn.chatgpt.com/docs/models" target="_blank" rel="noopener noreferrer">{t("Μοντέλα & reasoning ↗")}</a> · <a href="https://learn.chatgpt.com/docs/web-search" target="_blank" rel="noopener noreferrer">{t("Αναζήτηση & Deep research ↗")}</a></p>
      <div class="small-note"><strong>{t("Αν χρησιμοποιείς το απλό Chat:")}</strong> {t("επικόλλησε το ίδιο prompt και επίλεξε όποια ισχυρή επιλογή συλλογισμού εμφανίζεται. Ζήτησε αναζήτηση με πλήρεις πηγές. Αν δεν υπάρχει πρόσβαση στο web, ο agent μπορεί να οργανώσει τον φάκελο, αλλά δεν πρέπει να παρουσιάσει το ισχύον δίκαιο ως επαληθευμένο. Για ευαίσθητα έγγραφα, έλεγξε πρώτα τις ρυθμίσεις δεδομένων και κοινοποίησε μόνο όσα χρειάζονται.")}</div>
