---
import SectionIcon from './SectionIcon.astro';

interface Props {
  icon: 'start' | 'settings' | 'prompts' | 'team' | 'sources';
  headingId: string;
  title: string;
  description: string;
}

const { icon, headingId, title, description } = Astro.props;
---
<div class="section-header">
  <p>{description}</p>
  <div class="section-title-row">
    <SectionIcon name={icon} />
    <h2 id={headingId}>{title}</h2>
  </div>
</div>
