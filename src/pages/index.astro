---
import PromptPanel from '../components/PromptPanel.astro';
import { prompts, bundle } from '../lib/prompts';

const repository = 'michailkoutsouris/themis-ai';
const repositoryURL = `https://github.com/${repository}`;

// Escape HTML delimiters so Markdown cannot terminate a JSON script element.
const serialize = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173f35">
  <meta name="description" content="Θέμις: έτοιμα ελληνικά prompts για μεθοδική νομική έρευνα και σύνταξη αγωγών και ασφαλιστικών μέτρων στο ChatGPT. Οδηγίες, ρυθμίσεις και πηγές.">
  <title>Θέμις — Από την υπόθεση, στο κείμενο.</title>
  <style is:global>
    :root{--paper:#f6f4ed;--white:#fffef9;--ink:#24342d;--green:#173f35;--green-light:#e5ebe1;--line:#dcded3;--muted:#637064;--orange:#ba5938;--serif:Georgia,'Times New Roman',serif;--sans:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:30px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.65}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer}a{color:inherit;text-underline-offset:4px}button:focus-visible,a:focus-visible,textarea:focus-visible{outline:3px solid var(--orange);outline-offset:5px}button:disabled{cursor:wait;opacity:.7}button{touch-action:manipulation}::selection{background:#d7e5ca;color:var(--green)}[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip{position:fixed;top:10px;left:10px;transform:translateY(-180%);background:var(--green);color:white;padding:12px;z-index:20}.skip:focus{transform:none}
    .layout{max-width:1600px;margin:auto;display:grid;grid-template-columns:238px minmax(0,1fr)}.rail{border-right:1px solid var(--line);padding:38px 28px;position:sticky;top:0;height:100dvh;display:flex;flex-direction:column;align-self:start}.brand{display:flex;flex-shrink:0;align-items:center;gap:12px;text-decoration:none}.brand-name{font-family:var(--serif);font-size:31px;letter-spacing:-1px}.brand-sub{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;margin-top:14px;color:var(--muted)}.rail nav{display:flex;flex-direction:column;gap:6px;margin-top:clamp(20px,6vh,65px);min-height:0;overflow-y:auto}.rail nav a{padding:10px 0;text-decoration:none;display:flex;gap:17px;align-items:center;color:var(--muted);font-size:13px}.rail nav a:hover{color:var(--green)}.nav-number{font-size:10px;font-family:ui-monospace,monospace;color:#899184}.rail-note{flex-shrink:0;margin-top:auto;padding-top:25px;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}.rail-note strong{display:block;color:var(--green);font-weight:600;margin-bottom:5px}.edition{font:10px ui-monospace,monospace;letter-spacing:.5px;margin-top:20px}.main{min-width:0;padding:0 54px}.topline{min-height:88px;padding-block:18px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);font-size:11px;color:var(--muted);gap:20px}.dot{width:6px;height:6px;border-radius:50%;background:var(--orange)}.eyebrow{display:block;color:var(--muted);font-size:10px;letter-spacing:1.5px;font-weight:600;text-transform:uppercase}.hero{padding:53px 0 48px}.hero h1{font-family:var(--serif);font-weight:400;font-size:clamp(38px,4.1vw,65px);line-height:1.12;letter-spacing:-2.5px;margin:20px 0 23px}.hero h1 em{font-style:normal;color:var(--orange)}.hero-copy{max-width:580px;color:var(--muted);font-size:15px;line-height:1.85;margin:0}.hero-actions{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-top:29px}.button{display:inline-flex;justify-content:center;align-items:center;gap:18px;padding:13px 20px;min-height:48px;border:1px solid transparent;text-decoration:none;font-size:13px;font-weight:550;border-radius:3px;transition:background .15s,transform .15s}.button.primary{background:var(--green);color:var(--white)}.button.primary:hover{background:#255446}.button.secondary{background:transparent;border-color:#c8cebf;color:var(--green)}.button.secondary:hover{background:var(--green-light)}.text-link{font-size:12px;font-weight:500}.scope-strip{border-block:1px solid var(--line);padding:15px 0;display:flex;gap:25px;align-items:center;color:var(--muted);font-size:11px}.scope-strip span{display:flex;align-items:center;gap:9px}.scope-strip b{font-size:12px;color:var(--orange);font-weight:400}.section{padding:49px 0;border-bottom:1px solid var(--line)}.section-header{display:flex;gap:22px;align-items:flex-start;margin-bottom:28px}.section-index{font-family:var(--serif);font-size:19px;color:var(--orange);padding-top:4px}.section-header h2{font-family:var(--serif);font-size:32px;font-weight:400;line-height:1.2;margin:0 0 10px;letter-spacing:-.6px}.section-header p{font-size:13px;color:var(--muted);margin:0;max-width:660px}.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.step{padding:22px 0 0;border-top:1px solid #b5c1ae}.step-num{font:11px ui-monospace,monospace;color:var(--muted);display:block;margin-bottom:13px}.step h3{font-size:14px;margin:0 0 8px;font-weight:600}.step p{font-size:12px;color:var(--muted);margin:0;line-height:1.85}.small-note{margin-top:23px;padding:15px 19px;background:#eeece2;border-left:2px solid #a99e7d;color:#66644f;font-size:12px;line-height:1.85}.small-note strong{color:var(--ink)}.setup{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);background:var(--white);border-radius:4px}.model-card{padding:27px;border-right:1px solid var(--line);display:flex;flex-direction:column}.recommended{font:10px ui-monospace,monospace;letter-spacing:1px;color:var(--orange);display:flex;align-items:center;gap:7px}.model-card h3{font:36px var(--serif);letter-spacing:-1px;margin:13px 0 4px}.model-card p{font-size:12px;color:var(--muted);margin:0 0 15px}.model-card .model-foot{font-size:11px;line-height:1.8;margin:auto 0 0}.settings-list{padding:12px 24px;margin:0;list-style:none}.settings-list li{padding:13px 0;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);gap:15px;font-size:12px}.settings-list li:last-child{border:0}.setting-value{color:var(--green);font-weight:600;text-align:right}.sources-inline{font-size:11px;color:var(--muted);margin:15px 0 0;line-height:1.9}.sources-inline a:hover{color:var(--orange)}
    .library{background:var(--white);border:1px solid var(--line);border-radius:4px;overflow:hidden}.tabs{display:flex;background:#eeefe6;border-bottom:1px solid var(--line);padding:0 14px;overflow-x:auto}.tab{flex:1;white-space:nowrap;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted);font-size:12px;padding:17px 11px;min-height:50px}.tab[aria-selected=true]{border-bottom-color:var(--green);color:var(--green);font-weight:650}.tab:hover{background:#e4e8db}.prompt-panel{padding:26px 27px 0}.prompt-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;margin-bottom:21px}.prompt-heading h3{font-family:var(--serif);font-size:25px;letter-spacing:-.4px;font-weight:400;margin:8px 0 5px}.prompt-heading p{margin:0;color:var(--muted);font-size:12px;max-width:610px}.file-type{font:11px ui-monospace,monospace;padding:4px 8px;background:var(--green-light);color:var(--green);border:1px solid #d6dfd1;border-radius:3px}.prompt-text{width:100%;display:block;min-height:340px;height:360px;padding:21px;border:1px solid #e0e3d7;border-radius:2px;background:#f7f8f1;color:#384638;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;line-height:1.95;resize:vertical;tab-size:2;white-space:pre-wrap;overflow-wrap:anywhere}.prompt-text.expanded{height:680px}.prompt-bottom{display:flex;justify-content:space-between;align-items:center;gap:15px;min-height:53px;color:var(--muted);font-size:10px}.text-button{border:0;padding:10px 0;background:transparent;color:var(--green);font-size:11px}.text-button span{margin-left:8px}.library-actions{padding:18px 27px;display:flex;justify-content:space-between;align-items:center;gap:15px;border-top:1px solid var(--line);background:#fafbf4}.library-actions .button{font-size:12px}.download{font-size:11px;display:flex;align-items:center;gap:8px}.library-help{font-size:12px;color:var(--muted);margin:17px 0 0;line-height:1.85}.team{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0}.person{padding:20px 12px 20px 0;border-top:1px solid var(--line)}.person:nth-child(n+5){border-top:1px solid var(--line)}.person-name{font:21px var(--serif);margin:0 0 5px}.person-task{font-size:11px;color:var(--muted);line-height:1.7;margin:0}.specialists{font-size:12px;color:var(--muted);padding-top:18px;border-top:1px solid var(--line);margin:0}.source-list{display:grid;grid-template-columns:1fr 1fr;gap:0 30px}.source-row{display:flex;justify-content:space-between;gap:15px;text-decoration:none;border-top:1px solid var(--line);padding:17px 0}.source-row strong{font-size:12px;font-weight:550;display:block}.source-row small{color:var(--muted);font-size:11px;display:block;margin-top:3px}.source-row .arrow{font-size:18px;color:var(--orange)}.source-row:hover strong{text-decoration:underline;text-underline-offset:4px}.faq{margin-top:25px}.faq details{border-top:1px solid var(--line);padding:16px 0}.faq summary{cursor:pointer;font-size:13px;font-weight:550}.faq details p{font-size:12px;line-height:1.85;color:var(--muted);margin:11px 0 0;max-width:800px}.closing{display:flex;gap:30px;justify-content:space-between;padding:26px 0 35px;color:var(--muted);font-size:10px}.closing p{margin:0;max-width:600px}.closing span{white-space:nowrap;font-family:ui-monospace,monospace}.toast{position:fixed;bottom:26px;left:50%;transform:translate(-50%,20px);background:var(--green);color:white;padding:13px 21px;border-radius:4px;font-size:12px;box-shadow:0 6px 28px #173f3522;max-width:calc(100% - 30px);z-index:100;opacity:0;pointer-events:none;transition:opacity .15s,transform .15s}.toast.show{opacity:1;transform:translate(-50%,0)}.noscript{padding:16px;background:#ece6d6;font-size:13px}
    .repo-meta{display:flex;align-items:center;gap:16px;flex-shrink:0}.repo-meta a{text-decoration:none;display:inline-flex;align-items:center;gap:6px;min-height:28px}.repo-meta a:hover{text-decoration:underline}.repo-link{color:var(--green);font-weight:600}.repo-stat{font-family:ui-monospace,monospace;font-size:11px}.repo-stat [data-repo-stars],.repo-stat [data-repo-forks]{font-variant-numeric:tabular-nums}.closing .license-note{margin-top:12px;line-height:1.9}.license-note a{color:var(--green)}
    @media(min-width:1450px){.main{padding-inline:70px}}
    @media(max-width:1100px){.layout{grid-template-columns:190px minmax(0,1fr)}.rail{padding:30px 22px}.main{padding:0 30px}.hero h1{font-size:46px;letter-spacing:-1.8px}.scope-strip{gap:17px}.scope-strip span{font-size:10px}.team{grid-template-columns:repeat(2,minmax(0,1fr))}.model-card,.prompt-panel{padding:22px}.library-actions{padding:17px 22px}}
    @media(max-width:800px){.layout{display:block}.rail{height:auto;position:static;padding:19px 24px;border-right:0;border-bottom:1px solid var(--line);flex-direction:row;justify-content:space-between;align-items:center}.brand-name{font-size:27px}.brand-sub,.rail-note{display:none}.rail nav{flex-direction:row;margin:0;gap:17px}.rail nav a{font-size:11px}.nav-number{display:none}.rail nav a:nth-child(3),.rail nav a:nth-child(4){display:none}.topline{min-height:72px;padding-block:14px;font-size:10px}.main{padding:0 25px}.hero{padding:35px 0}.hero h1{font-size:43px}.hero-copy{font-size:13px}.section{padding:35px 0}.section-header h2{font-size:29px}.section-header{gap:15px}.section-header p{font-size:12px}.steps{gap:19px}.setup{grid-template-columns:1fr 1fr}.model-card{padding:23px 20px}.settings-list{padding:10px 18px}.settings-list li{font-size:11px}.prompt-panel{padding:22px 20px 0}.library-actions{padding:16px 20px}.tab{font-size:11px;padding-inline:10px}.tabs{padding:0 5px}}
    @media(max-width:560px){.main{padding:0 20px}.rail{padding:17px 20px;gap:10px;align-items:flex-start;flex-direction:column}.rail nav{gap:4px 18px;flex-wrap:wrap}.rail nav a{padding-block:6px}.topline>span:first-child{font-size:9px;letter-spacing:.2px}.hero{padding-top:30px}.hero h1{font-size:45px;letter-spacing:-1.6px}.hero-copy{font-size:14px}.hero-actions{gap:20px;margin-top:24px}.hero-actions .button{width:100%;justify-content:space-between}.hero-actions .text-link{font-size:12px}.scope-strip{flex-wrap:wrap;gap:7px 20px;padding:13px 0}.scope-strip span{font-size:10px}.steps{grid-template-columns:1fr;gap:19px}.step{padding-top:14px;display:grid;grid-template-columns:29px 1fr;gap:0 12px}.step-num{grid-row:1/3;margin-top:2px}.step h3{font-size:14px;margin-bottom:5px}.step p{font-size:12px}.section-index{font-size:17px}.section-header h2{font-size:27px}.setup{grid-template-columns:1fr}.model-card{border-right:0;border-bottom:1px solid var(--line)}.model-card h3{font-size:33px}.settings-list{padding:7px 20px}.settings-list li{font-size:12px}.prompt-heading h3{font-size:23px}.prompt-heading p{font-size:11px}.prompt-panel{padding:20px 14px 0}.prompt-text{font-size:11px;padding:14px;height:365px}.prompt-text.expanded{height:600px}.library-actions{padding:15px 14px;align-items:stretch;flex-direction:column}.library-actions .button{justify-content:space-between}.download{justify-content:center;padding:6px 0}.prompt-bottom{gap:8px;font-size:9px}.text-button{font-size:10px}.tabs{gap:0}.tab{font-size:10px;flex:0 0 auto;padding-inline:12px}.team{gap:0 14px}.person{padding-right:0}.person-name{font-size:20px}.source-list{grid-template-columns:1fr}.closing{flex-direction:column;gap:10px}.small-note{padding:13px 15px}.eyebrow{font-size:9px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
    @media print{.rail,.hero-actions,.library-actions,.tabs,.toast,.expand{display:none!important}.layout{display:block}.main{padding:0}.section{break-inside:avoid}.prompt-text{height:250px}.topline{min-height:40px}body{background:white}}
  </style>
</head>
<body>
<a href="#content" class="skip">Μετάβαση στο περιεχόμενο</a>
<div class="layout">
  <aside class="rail" aria-label="Πλοήγηση σελίδας">
    <div><a class="brand" href="#top" aria-label="Θέμις — αρχή"><span class="brand-name">Θέμις.</span></a><div class="brand-sub">Νομική σκέψη, σε σειρά.</div></div>
    <nav aria-label="Ενότητες"><a href="#start"><span class="nav-number">01</span>Πώς ξεκινάς</a><a href="#settings"><span class="nav-number">02</span>Μοντέλο & ρυθμίσεις</a><a href="#prompts"><span class="nav-number">03</span>Τα prompts</a><a href="#team"><span class="nav-number">04</span>Η ομάδα</a><a href="#sources"><span class="nav-number">05</span>Πηγές & διευκρινίσεις</a></nav>
    <div class="rail-note"><strong>Πρώτα οι σωστές ερωτήσεις.</strong>Μετά η έρευνα.<br>Έπειτα το κείμενο.<div class="edition">ΕΚΔΟΣΗ 1.0 / 29.10.2026</div></div>
  </aside>
  <main class="main" id="content">
    <div class="topline" id="top">
      <span>ΒΙΒΛΙΟΘΗΚΗ PROMPTS / ΕΛΛΗΝΙΚΟ ΔΙΚΑΙΟ</span>
      <div class="repo-meta" aria-label="Αποθετήριο GitHub" data-api-url={`https://api.github.com/repos/${repository}`}>
        <a class="repo-link" href={repositoryURL} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a class="repo-stat" href={`${repositoryURL}/stargazers`} target="_blank" rel="noopener noreferrer" aria-label="Stars στο GitHub"><span aria-hidden="true">☆</span> <span data-repo-stars title="Ο αριθμός δεν είναι διαθέσιμος">—</span><span class="sr-only"> stars</span></a>
        <a class="repo-stat" href={`${repositoryURL}/forks`} target="_blank" rel="noopener noreferrer" aria-label="Forks στο GitHub">Forks <span data-repo-forks title="Ο αριθμός δεν είναι διαθέσιμος">—</span></a>
      </div>
    </div>
    <header class="hero">
      <div><span class="eyebrow">ΑΓΩΓΕΣ & ΑΣΦΑΛΙΣΤΙΚΑ ΜΕΤΡΑ</span><h1>Η υπόθεσή σου.<br><em>Μεθοδικά, από την αρχή.</em></h1><p class="hero-copy">Μια ομάδα ειδικών ρόλων για την έρευνα, τις σωστές ερωτήσεις και τη σύνταξη. Αντέγραψε το prompt και ξεκίνα με τη Θέμις στο ChatGPT.</p><div class="hero-actions"><button class="button primary" data-copy="start">Αντιγραφή βασικού prompt <span aria-hidden="true">↗</span></button><a class="text-link" href="https://chatgpt.com/" target="_blank" rel="noopener noreferrer">Άνοιγμα ChatGPT ↗</a></div></div>
    </header>
    <div class="scope-strip"><span><b aria-hidden="true">↳</b>Ελλάδα · πολλαπλά αντικείμενα</span><span><b aria-hidden="true">↳</b>Ερωτήσεις πριν από τη σύνταξη</span><span><b aria-hidden="true">↳</b>Πλήρες κείμενο χωρίς placeholders</span></div>
    <section class="section" id="start" aria-labelledby="start-title">
      <div class="section-header"><span class="section-index" aria-hidden="true">01</span><div><h2 id="start-title">Από εδώ ξεκινάς.</h2><p>Δεν χρειάζεται να γνωρίζεις νομικούς όρους. Περιέγραψε τι συνέβη και τι θέλεις να πετύχεις.</p></div></div>
      <div class="steps"><article class="step"><span class="step-num">ΒΗΜΑ 01</span><h3>Άνοιξε νέα συνομιλία</h3><p>Προτίμησε το Work, αν είναι διαθέσιμο. Επίλεξε μοντέλο και δυνατότητα αναζήτησης όπως περιγράφονται παρακάτω.</p></article><article class="step"><span class="step-num">ΒΗΜΑ 02</span><h3>Επικόλλησε το βασικό prompt</h3><p>Πάτησε «Αντιγραφή βασικού prompt», επικόλλησέ το ως πρώτο μήνυμα και στείλε το. Δεν χρειάζεται να συμπληρώσεις πεδία.</p></article><article class="step"><span class="step-num">ΒΗΜΑ 03</span><h3>Απάντησε στις ερωτήσεις</h3><p>Η Θέμις θα ζητήσει τα απαραίτητα στοιχεία και έγγραφα. Αν υπάρχει επίδοση, δικάσιμος ή κοντινή προθεσμία, ανέφερέ την αμέσως.</p></article></div>
      <div class="small-note"><strong>Τι σημαίνει «χωρίς κενά»:</strong> το prompt ζητά να καλυφθούν πρώτα τα αναγκαία στοιχεία. Αν ένα κρίσιμο στοιχείο ή μια νομική πηγή δεν μπορεί να επαληθευτεί, η πλήρης έκδοση σταματά με συγκεκριμένη εξήγηση. Δεν επινοούνται δεδομένα.</div>
    </section>
    <section class="section" id="settings" aria-labelledby="settings-title">
      <div class="section-header"><span class="section-index" aria-hidden="true">02</span><div><h2 id="settings-title">Το περιβάλλον εργασίας σου.</h2><p>Προτεινόμενη αφετηρία για απαιτητική έρευνα. Τα ονόματα και οι επιλογές διαφέρουν ανά συνδρομή, λογαριασμό και workspace.</p></div></div>
      <div class="setup"><article class="model-card"><span class="recommended"><span class="dot" aria-hidden="true"></span>ΠΡΟΤΕΙΝΟΜΕΝΟ · CHATGPT WORK</span><h3>GPT‑6 Astra</h3><p>Για σύνθετη έρευνα και έλεγχο πολλών πηγών.</p><p class="model-foot">Αν δεν εμφανίζεται, επίλεξε το ισχυρότερο διαθέσιμο reasoning μοντέλο με αναζήτηση και ανάγνωση αρχείων. Το GPT‑6.1 Sol είναι εναλλακτική όπου προσφέρεται. Μην θεωρείς ίδια την απόδοση χωρίς δοκιμή.</p></article><ul class="settings-list"><li><span>Βάθος σκέψης</span><span class="setting-value">High, όπου διατίθεται</span></li><li><span>Ζωντανή αναζήτηση</span><span class="setting-value">Διαθέσιμη & σε χρήση</span></li><li><span>Ανάγνωση συνημμένων</span><span class="setting-value">PDF / κείμενο / εικόνες</span></li><li><span>Deep research</span><span class="setting-value">Προαιρετικά, για έρευνα</span></li><li><span>Οργάνωση</span><span class="setting-value">Μία υπόθεση ανά chat</span></li></ul></div>
      <p class="sources-inline">Η επιλογή High είναι δική μας πρόταση για αυτό το σύνθετο έργο, όχι επίσημη νομική σύσταση ή εγγύηση. Δεν χρειάζεται ρύθμιση temperature ή API key για copy–paste στο ChatGPT. Το prompt δεν ενεργοποιεί εργαλεία ή μοντέλα από μόνο του. <a href="https://learn.chatgpt.com/docs/models" target="_blank" rel="noopener noreferrer">Μοντέλα & reasoning ↗</a> · <a href="https://learn.chatgpt.com/docs/web-search" target="_blank" rel="noopener noreferrer">Αναζήτηση & Deep research ↗</a></p>
      <div class="small-note"><strong>Αν χρησιμοποιείς το απλό Chat:</strong> επικόλλησε το ίδιο prompt και επίλεξε όποια ισχυρή επιλογή συλλογισμού εμφανίζεται. Ζήτησε αναζήτηση με πλήρεις πηγές. Αν δεν υπάρχει πρόσβαση στο web, ο agent μπορεί να οργανώσει τον φάκελο, αλλά δεν πρέπει να παρουσιάσει το ισχύον δίκαιο ως επαληθευμένο. Για ευαίσθητα έγγραφα, έλεγξε πρώτα τις ρυθμίσεις δεδομένων και κοινοποίησε μόνο όσα χρειάζονται.</div>
    </section>
    <section class="section" id="prompts" aria-labelledby="prompts-title">
      <div class="section-header"><span class="section-index" aria-hidden="true">03</span><div><h2 id="prompts-title">Αντιγραφή. Επικόλληση. Εκκίνηση.</h2><p>Το πρώτο prompt αρκεί για να ξεκινήσεις. Τα υπόλοιπα χρησιμοποιούνται στα επόμενα στάδια, όταν χρειάζονται.</p></div></div>
      <noscript><p class="noscript">Η JavaScript είναι απενεργοποιημένη. Αντέγραψε χειροκίνητα το βασικό prompt από το πλαίσιο ή κατέβασε <a href="themis-prompts.md" download>το πλήρες πακέτο Markdown</a>.</p></noscript>
      <div class="library"><div class="tabs" role="tablist" aria-label="Επιλογή prompt">{prompts.map((prompt, index) => (
        <button class="tab" id={`tab-${prompt.id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`panel-${prompt.id}`} tabindex={index === 0 ? 0 : -1} data-tab={prompt.id}>{prompt.label}</button>
      ))}</div>{prompts.map((prompt, index) => <PromptPanel prompt={prompt} index={index} />)}<div class="library-actions"><button class="button primary" id="copy-selected">Αντιγραφή αυτού του prompt <span aria-hidden="true">↗</span></button><a class="download" href="themis-prompts.md" download="themis-prompts.md"><span aria-hidden="true">↓</span> Λήψη όλων σε .md</a></div></div>
      <p class="library-help">Για δεύτερο έλεγχο: άνοιξε νέα συνομιλία και δώσε το αντίστοιχο prompt, το σχέδιο και τα κρίσιμα αρχεία. Δεν μεταφέρονται αυτόματα στοιχεία από άλλο chat. Για συνέχεια σε νέο chat, δώσε ξανά το βασικό prompt μαζί με τον εξαγόμενο φάκελο.</p>
    </section>
    <section class="section" id="team" aria-labelledby="team-title">
      <div class="section-header"><span class="section-index" aria-hidden="true">04</span><div><h2 id="team-title">Μία ομάδα. Διακριτές ευθύνες.</h2><p>Οκτώ ονομασμένοι ρόλοι εξετάζουν διαφορετικές πλευρές της ίδιας υπόθεσης.</p></div></div>
      <div class="team"><article class="person"><h3 class="person-name">Θέμις</h3><p class="person-task">Συντονισμός & φάκελος υπόθεσης</p></article><article class="person"><h3 class="person-name">Μαιευτική</h3><p class="person-task">Συνέντευξη & πραγματικά περιστατικά</p></article><article class="person"><h3 class="person-name">Τεκμήριος</h3><p class="person-task">Έγγραφα & αποδεικτική υποστήριξη</p></article><article class="person"><h3 class="person-name">Νομοθέα</h3><p class="person-task">Νομοθεσία & νομολογία</p></article><article class="person"><h3 class="person-name">Δικονομία</h3><p class="person-task">Διαδικασία & προθεσμίες</p></article><article class="person"><h3 class="person-name">Αντίλογος</h3><p class="person-task">Αντιρρήσεις & αδύναμα σημεία</p></article><article class="person"><h3 class="person-name">Καλλιόπη</h3><p class="person-task">Σύνταξη & συνοχή κειμένου</p></article><article class="person"><h3 class="person-name">Ακρίβεια</h3><p class="person-task">Παραπομπές & τελικός έλεγχος</p></article></div>
      <p class="specialists">Κατά περίπτωση προστίθενται: Εστία · Εργάνη · Αρμονία · Συναλλαγή · Αποκατάσταση · Πολιτεία, για το ειδικό αντικείμενο της διαφοράς.</p>
      <div class="small-note"><strong>Ρόλοι και πραγματικοί subagents:</strong> σε μια απλή συνομιλία, οι παραπάνω είναι οπτικές του ίδιου μοντέλου. Πραγματικές ξεχωριστές εκτελέσεις υπάρχουν μόνο αν το περιβάλλον παρέχει εργαλεία υποανάθεσης και όντως χρησιμοποιηθούν. Το prompt απαγορεύει να παρουσιάζεται μια προσομοίωση ως ανεξάρτητη επαλήθευση.</div>
    </section>
    <section class="section" id="sources" aria-labelledby="sources-title">
      <div class="section-header"><span class="section-index" aria-hidden="true">05</span><div><h2 id="sources-title">Η έρευνα ξεκινά από την πηγή.</h2><p>Οι σύνδεσμοι περιέχονται και στο βασικό prompt. Είναι αφετηρίες έρευνας, όχι προεγκεκριμένη βιβλιογραφία για κάθε υπόθεση.</p></div></div>
      <div class="source-list">
        <a class="source-row" href="https://search.et.gr/el/search-legislation/" target="_blank" rel="noopener noreferrer"><span><strong>Εθνικό Τυπογραφείο</strong><small>Νομοθεσία & εντοπισμός ΦΕΚ</small></span><span class="arrow" aria-hidden="true">↗</span></a>
        <a class="source-row" href="https://www.hellenicparliament.gr/Nomothetiko-Ergo/Anazitisi-Nomothetikou-Ergou/" target="_blank" rel="noopener noreferrer"><span><strong>Βουλή των Ελλήνων</strong><small>Νομοθετικοί φάκελοι & συνοδευτικά κείμενα</small></span><span class="arrow" aria-hidden="true">↗</span></a>
        <a class="source-row" href="https://www.areiospagos.gr/nomologia/rulings_per_year.asp" target="_blank" rel="noopener noreferrer"><span><strong>Άρειος Πάγος</strong><small>Πολιτικές & ποινικές αποφάσεις</small></span><span class="arrow" aria-hidden="true">↗</span></a>
        <a class="source-row" href="https://www.gov.gr/el/services/1000382/anazetese-nomologias" target="_blank" rel="noopener noreferrer"><span><strong>Gov.gr · Νομολογία</strong><small>ΣτΕ & διοικητικά δικαστήρια</small></span><span class="arrow" aria-hidden="true">↗</span></a>
        <a class="source-row" href="https://eur-lex.europa.eu/collection/eu-law/consleg.html?locale=el" target="_blank" rel="noopener noreferrer"><span><strong>EUR‑Lex</strong><small>Ενωσιακό δίκαιο & ενοποιημένες εκδόσεις</small></span><span class="arrow" aria-hidden="true">↗</span></a>
        <a class="source-row" href="https://curia.europa.eu/" target="_blank" rel="noopener noreferrer"><span><strong>Δικαστήριο της Ευρωπαϊκής Ένωσης</strong><small>Ενωσιακή νομολογία</small></span><span class="arrow" aria-hidden="true">↗</span></a>
        <a class="source-row" href="https://www.echr.coe.int/en/hudoc-database" target="_blank" rel="noopener noreferrer"><span><strong>ΕΔΔΑ · HUDOC</strong><small>Νομολογία για την ΕΣΔΑ</small></span><span class="arrow" aria-hidden="true">↗</span></a>
        <a class="source-row" href="https://e-justice.europa.eu/topics/money-monetary-claims/securing-assets-during-claim-eu-countries/el_en" target="_blank" rel="noopener noreferrer"><span><strong>Ευρωπαϊκή e‑Justice</strong><small>Εισαγωγικός οδηγός ασφαλιστικών μέτρων Ελλάδας</small></span><span class="arrow" aria-hidden="true">↗</span></a>
      </div>
      <p class="sources-inline">Κάθε κρίσιμη πηγή χρειάζεται ανάγνωση του σχετικού κειμένου και έλεγχο χρονικής ισχύος. Η πρόσβαση μπορεί να περιορίζεται από σύνδεση, συνδρομή ή τεχνικά εμπόδια. Ακόμη και επίσημοι οδηγοί μπορεί να χρειάζονται επικαιροποίηση. Πρόσθετη επιστημονική βιβλιογραφία επιλέγεται ανά υπόθεση, με επαληθευμένη έκδοση και σελίδα.</p>
      <div class="faq">
        <details><summary>Μπορώ να το κρατήσω ως μόνιμο agent;</summary><p>Ναι, ως επαναχρησιμοποιήσιμες οδηγίες όπου το υποστηρίζει ο λογαριασμός σου. Σε διαθέσιμο editor οδηγιών, βάλε εκεί το βασικό prompt. Αν το όριο κειμένου δεν επαρκεί, χρησιμοποίησέ το ως πρώτο μήνυμα σε νέο chat. Μην υποθέτεις ότι ένα ανεβασμένο αρχείο γνώσης έχει την ίδια προτεραιότητα με τις οδηγίες. Η OpenAI τεκμηριώνει μετάβαση Custom GPTs σε plugins/skills· η διαθεσιμότητα διαφέρει. <a href="https://learn.chatgpt.com/docs/build-plugins" target="_blank" rel="noopener noreferrer">Οδηγός plugins ↗</a> · <a href="https://learn.chatgpt.com/docs/migrate-custom-gpts" target="_blank" rel="noopener noreferrer">Οδηγός μετάβασης ↗</a></p></details>
        <details><summary>Το αποτέλεσμα είναι έτοιμο για κατάθεση;</summary><p>Η πλήρης σύνταξη δεν ισοδυναμεί με νόμιμη υπογραφή, κατάθεση ή επίδοση. Ο agent πρέπει να ερευνήσει τις απαιτήσεις της συγκεκριμένης διαδικασίας και να τις εξηγήσει χωριστά. Δεν υποκαθιστά υποχρεωτική δικηγορική παράσταση, δεν υπογράφει και δεν εκδίδει νομική πιστοποίηση. Οι πολλαπλοί έλεγχοι AI δεν εγγυώνται ορθότητα ή δικαστική επιτυχία.</p></details>
        <details><summary>Χρειάζεται να δώσω όλα τα προσωπικά μου στοιχεία;</summary><p>Για την αρχική συζήτηση μπορείς να χρησιμοποιείς ψευδώνυμα και να αφαιρείς μη αναγκαία προσωπικά δεδομένα. Για πλήρες έγγραφο θα ζητηθούν όσα στοιχεία είναι πραγματικά αναγκαία. Η παρούσα σελίδα δεν δέχεται έγγραφα ή στοιχεία υπόθεσης και δεν αποστέλλει το prompt αυτόματα στο ChatGPT. Το μεταφέρεις εσύ με αντιγραφή.</p></details>
        <details><summary>Πώς ξέρω ότι το prompt αποδίδει σωστά;</summary><p>Η έκδοση 1.0 είναι αφετηρία εργασίας, όχι κλινικά ή επαγγελματικά επικυρωμένο νομικό σύστημα. Δοκίμασέ το αρχικά με ανωνυμοποιημένη υπόθεση και γνωστά στοιχεία. Έλεγξε ότι ρωτά για κενά, δεν επινοεί πηγές και δηλώνει όσα δεν μπόρεσε να επαληθεύσει. Ο τεχνικός έλεγχος της σελίδας δεν αποτελεί αξιολόγηση νομικής ακρίβειας του μοντέλου.</p></details>
      </div>
    </section>
