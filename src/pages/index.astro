<script is:inline id="prompt-data" type="application/json" set:html={serialize(prompts)} />
<script is:inline id="bundle-data" type="application/json" set:html={serialize(bundle)} />
<script is:inline>
(() => {
  'use strict';
  const prompts = JSON.parse(document.getElementById('prompt-data').textContent);
  const byId = new Map(prompts.map(prompt => [prompt.id, prompt]));
  const tabs = Array.from(document.querySelectorAll('[data-tab]'));
  let selected = 'start';
  let toastTimer;
  function notify(message) {
    const toast = document.getElementById('toast');
    clearTimeout(toastTimer);
    toast.textContent = message;
    toast.classList.add('show');
    toastTimer = setTimeout(() => toast.classList.remove('show'), 6500);
  }
  function selectTab(id, focus = false) {
    if (!byId.has(id)) return;
    selected = id;
    for (const tab of tabs) {
      const active = tab.dataset.tab === id;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      document.getElementById('panel-' + tab.dataset.tab).hidden = !active;
      if (active && focus) tab.focus();
    }
  }
  async function copy(id, button) {
    const prompt = byId.get(id);
    if (!prompt) return;
    button.disabled = true;
    try {
      let copied = false;
      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        try { await navigator.clipboard.writeText(prompt.content); copied = true; } catch (_) { /* File and permission fallback below. */ }
      }
      if (!copied) {
        selectTab(id);
        const field = document.getElementById('text-' + id);
        field.focus();
        field.select();
        field.setSelectionRange(0, field.value.length);
        try { copied = typeof document.execCommand === 'function' && document.execCommand('copy'); } catch (_) { copied = false; }
        if (!copied) {
          document.getElementById('prompts').scrollIntoView({block:'start'});
          notify('Το κείμενο επιλέχθηκε. Πάτησε Ctrl+C ή ⌘C για χειροκίνητη αντιγραφή.');
          return;
        }
      }
      button.focus({preventScroll:true});
      notify('Αντιγράφηκε: ' + prompt.label + '. Επικόλλησέ το στο ChatGPT.');
    } finally { button.disabled = false; }
  }
  for (const tab of tabs) {
    tab.addEventListener('click', () => selectTab(tab.dataset.tab));
    tab.addEventListener('keydown', event => {
      const index = tabs.indexOf(tab);
      let next;
      if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabs.length - 1;
      if (next !== undefined) { event.preventDefault(); selectTab(tabs[next].dataset.tab, true); }
    });
  }
  for (const button of document.querySelectorAll('[data-copy]')) button.addEventListener('click', () => copy(button.dataset.copy, button));
  document.getElementById('copy-selected').addEventListener('click', event => copy(selected, event.currentTarget));
  document.querySelector('.download').addEventListener('click', event => {
    event.preventDefault();
    const bundle = JSON.parse(document.getElementById('bundle-data').textContent);
    const url = URL.createObjectURL(new Blob([bundle], {type:'text/markdown;charset=utf-8'}));
    const link = document.createElement('a');
    link.href = url;
    link.download = 'themis-prompts.md';
    document.body.append(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 10000);
  });
  for (const button of document.querySelectorAll('[data-expand]')) {
    button.addEventListener('click', () => {
      const field = document.getElementById('text-' + button.dataset.expand);
      const expanded = field.classList.toggle('expanded');
      button.setAttribute('aria-expanded', String(expanded));
      button.textContent = expanded ? 'Σύμπτυξη κειμένου ↙' : 'Ανάπτυξη κειμένου ↗';
    });
  }
})();
</script>
<script is:inline>
(async () => {
  const meta = document.querySelector('.repo-meta');
  try {
    const response = await fetch(meta.dataset.apiUrl, {
      headers: { Accept: 'application/vnd.github+json' },
      credentials: 'omit',
      referrerPolicy: 'no-referrer',
      signal: AbortSignal.timeout(5000),
    });
    if (!response.ok) return;
    const data = await response.json();
    const format = new Intl.NumberFormat('el-GR', { notation: 'compact', maximumFractionDigits: 1 });
    for (const [selector, value] of [['[data-repo-stars]', data.stargazers_count], ['[data-repo-forks]', data.forks_count]]) {
      if (!Number.isSafeInteger(value) || value < 0) continue;
      const count = meta.querySelector(selector);
      count.textContent = format.format(value);
      count.title = value.toLocaleString('el-GR');
    }
  } catch (_) { /* Keep the repository links usable when offline or rate limited. */ }
})();
</script>
